<?xml version="1.0" encoding="utf-8"?>
<packages>
  <!--
    crow_all.h is a single-header amalgamation that already bundles standalone Asio
    inside it — no separate NuGet package for Asio is needed.

    The only external dependency is crow_all.h itself.
    Download it from: https://github.com/CrowCpp/Crow/releases
    Place it in: WebServer\crow_all.h  (next to main.cpp)
  -->
</packages>
